# All optional. With no API, Willify can't search iTunes; with no AI provider, the DJ falls back to search.
# The shared backend (ew-apps-api): iTunes search, charts and "Willify AI (free)".
VITE_API_URL=http://localhost:8787
# Supabase project used for sign-in to the AI server.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to 1 once the Google provider is enabled in Supabase, to show "Continue with Google".
VITE_GOOGLE_SIGNIN=
# Apple Performance Partners affiliate token ("at"), added to every Apple Music link. Empty = no token.
VITE_APPLE_AFFILIATE_TOKEN=
